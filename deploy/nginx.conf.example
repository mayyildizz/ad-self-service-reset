# Reverse proxy with TLS in front of the app (app bound to 127.0.0.1:3800).
# Get a certificate with certbot, or use your internal CA.
server {
    listen 443 ssl http2;
    server_name reset.example.com;

    ssl_certificate     /etc/letsencrypt/live/reset.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/reset.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3800;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
server {
    listen 80;
    server_name reset.example.com;
    return 301 https://$host$request_uri;
}
# When using this, set TRUST_PROXY=true and HOST=127.0.0.1 in .env.
