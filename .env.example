# ── Web server ───────────────────────────────────────────────────────────────
HOST=127.0.0.1            # bind address; keep 127.0.0.1 behind nginx, 0.0.0.0 to expose directly
PORT=3800
NODE_ENV=production
# Public URL of the page (used only in e-mails). Example: https://reset.example.com
PUBLIC_URL=http://localhost:3800
# If nginx/another proxy sits in front, set to true so the client IP is taken from X-Forwarded-For
TRUST_PROXY=false

# ── Active Directory (LDAPS) ─────────────────────────────────────────────────
AD_HOST=dc1.example.com   # a domain controller with LDAPS (636) enabled
AD_PORT=636
# Service account that has been DELEGATED "Reset password" + write lockoutTime on the target OU.
# Use the UPN form (svc-pwreset@example.com) or the full DN.
AD_BIND_DN=svc-pwreset@example.com
AD_BIND_PASSWORD=change-me
# Only accounts under this DN can be reset.
AD_BASE_DN=OU=Staff,DC=example,DC=com
# Attribute that holds the RECOVERY e-mail the code is sent to.
# `mail` is the corporate mailbox — fine if mail is NOT tied to the AD password.
# If it is (Exchange/M365 with AD sync), store a personal address in another
# attribute (e.g. extensionAttribute1 or otherMailbox) and name it here.
AD_RECOVERY_MAIL_ATTR=mail
# Accounts that must NEVER be reset through this page (regex on the DN, case-insensitive).
AD_PROTECTED_DN_REGEX=OU=Admins|OU=Service Accounts
# Group names (CN) whose members are protected, comma separated.
AD_PROTECTED_GROUPS=Domain Admins,Enterprise Admins,Administrators,Schema Admins,Account Operators
# Force "user must change password at next logon" after a reset (true/false).
AD_MUST_CHANGE_AT_LOGON=false
# TLS: leave true. To trust an internal CA, export it (see docs/INSTALL.md) and set AD_CA_CERT.
AD_TLS_REJECT_UNAUTHORIZED=true
AD_CA_CERT=
AD_TIMEOUT_MS=10000

# ── Outgoing mail (SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false          # true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change-me
SMTP_FROM="IT Self Service <noreply@example.com>"
ORG_NAME=Example Corp
IT_CONTACT=IT helpdesk (ext. 100)

# ── One-time code policy ─────────────────────────────────────────────────────
OTP_TTL_MIN=10             # code lifetime
OTP_MAX_ATTEMPTS=5         # wrong guesses before the code is void
OTP_SENDS_PER_15MIN=3      # codes per username per 15 minutes
CHALLENGES_PER_IP_15MIN=10 # challenge requests per client IP per 15 minutes
RESETS_PER_DAY=3           # successful resets per account per day
PASSWORD_LENGTH=14

# ── Safety switches ──────────────────────────────────────────────────────────
# true = do everything (lookup, e-mail, code) but DO NOT write to AD. Use for the first end-to-end test.
RESET_DRY_RUN=true
# true = also print the one-time code to the server log. Refused when NODE_ENV=production.
OTP_DEBUG_LOG=false
# Audit trail (JSON lines, one per event). Directory must be writable by the service user.
AUDIT_LOG=./data/audit.jsonl
